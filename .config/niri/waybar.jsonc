{
    "layer": "top",
    "position": "top",
    "height": 28,
    "modules-left": ["niri/workspaces", "niri/window"],
    "modules-center": ["clock"],
    "modules-right": ["niri/language", "pulseaudio", "network", "battery", "tray"],
    "niri/window": { "max-length": 60 },
    "niri/language": { "format": "{short}" },
    "clock": { "format": "{:%a %d %b  %H:%M}" },
    "pulseaudio": { "format": "{icon} {volume}%", "format-muted": "󰝟 mute", "format-icons": { "default": ["", "", ""] }, "on-click": "pavucontrol" },
    "network": { "format-wifi": "  {essid}", "format-ethernet": "󰈀 {ipaddr}", "format-disconnected": "󰖪 offline" },
    "battery": { "format": "{icon} {capacity}%", "format-icons": ["", "", "", "", ""] },
    "tray": { "spacing": 8 }
}
