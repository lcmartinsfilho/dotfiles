// Sway waybar config (niri uses .config/niri/waybar.jsonc instead).
{
    "height": 30,
    "spacing": 4,
    "modules-left": ["sway/workspaces", "sway/mode", "sway/scratchpad"],
    "modules-center": ["sway/window"],
    "modules-right": ["idle_inhibitor", "pulseaudio", "network", "cpu", "memory", "backlight", "sway/language", "battery", "clock", "tray"],
    "sway/window": { "max-length": 60 },
    "idle_inhibitor": { "format": "{icon}", "format-icons": { "activated": "\uf06e", "deactivated": "\uf070" } },
    "pulseaudio": { "format": "{icon} {volume:3}%", "format-muted": "\udb81\udf9f mute", "format-icons": { "default": ["\uf026", "\uf027", "\uf028"] }, "on-click": "pavucontrol" },
    "network": { "format-wifi": "\uf1eb  {essid}", "format-ethernet": "\udb80\ude00 {ipaddr}", "format-disconnected": "\udb81\uddaa offline" },
    "cpu": { "format": "\uf2db {usage:3}%" },
    "memory": { "format": "\uf538 {used:4.1f}G" },
    "backlight": { "format": "{icon} {percent:3}%", "format-icons": ["\uf186", "\uf185"] },
    "battery": { "format": "{icon} {capacity:3}%", "format-icons": ["\uf244", "\uf243", "\uf242", "\uf241", "\uf240"] },
    "clock": {
        "format": "{:%Y-%m-%d  %H:%M}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
    },
    "tray": { "spacing": 8 }
}
